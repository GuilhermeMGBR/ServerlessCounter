{
  "name": "serverlesscounter",
  "version": "1.0.0",
  "description": "",
  "license": "MIT",
  "main": "./app.js",
  "scripts": {
    "prepare": "cd .. && husky",
    "format": "yarn base:prettier --write .",
    "format-check": "yarn base:prettier --check .",
    "lint": "eslint .",
    "type-check": "tsc -noEmit",
    "prebuild": "yarn",
    "build": "yarn build:only",
    "build:only": "npx babel . --extensions '.ts,.tsx' --out-dir ../dist",
    "postbuild": "find . -maxdepth 2 -name '*function.json' | xargs -I {} cp {} ../dist/{}; cp host.json .funcignore package.json yarn.lock local.settings.json ../dist; cd ../dist; yarn install --production",
    "prestart": "yarn build",
    "start": "yarn start:only",
    "start:only": "cd ../dist; func start --typescript",
    "test": "jest --verbose",
    "coverage": "jest --coverage",
    "sonar:only": "sonar-scanner-npm",
    "sonar": "yarn coverage; yarn sonar:only",
    "sonar-server:start": "docker run --name sonarqube-server-temp -p 127.0.0.1:9000:9000 --detach --rm sonarqube:community",
    "sonar-server:start-database": "docker run --name sonarqube-server-serverless-counter-db -p 127.0.0.1:9000:9000 --detach --rm --env-file .env.sonar-server.local sonarqube:community",
    "sonar-server:start-persistent": "docker restart sonarqube-server",
    "sonar-server:create-persistent": "docker run --name sonarqube-server -p 127.0.0.1:9000:9000 --detach sonarqube:community",
    "docker:start": "docker desktop start",
    "docker:stop": "docker desktop stop",
    "docker:stop-containers": "docker ps -q | xargs -r docker stop",
    "watch:generic": "npx onchange '**/*' --exclude 'dist/**/*' --",
    "watch:format-check": "yarn wg yarn base:prettier --check .",
    "watch:format-check-onlyChanged": "yarn wg yarn base:prettier --check {{changed}}",
    "watch:lint": "yarn wg yarn eslint .",
    "watch:lint-onlyChanged": "yarn wg yarn eslint {{changed}}",
    "watch:type-check": "yarn type-check --watch",
    "watch:build": "yarn build --watch",
    "watch:test": "yarn test --watch",
    "watch:test-onlyChanged": "yarn test --watch --onlyChanged",
    "pre-commit": "yarn type-check && yarn lint && yarn format-check && yarn test && yarn check-commit-blocked-terms",
    "check-commit-blocked-terms": "../.scripts/checkCommitBlockedTerms.sh",
    "node:env": "node ../.scripts/node-env.js",
    "act:run-workflow": "run_workflow () { act --platform ubuntu-latest=node:24-bullseye-slim --container-architecture linux/amd64 --directory ../ --secret-file ./.secrets --workflows ./.github/workflows/$1 --job $2 --quiet ${@:3}; }; run_workflow",
    "act:sonarcloud": "yarn a:r sonarcloud-coverage.yml sonarcloud --container-architecture linux/amd64",
    "act:deploy": "yarn a:r deploy.yml build-and-deploy",
    "act:health-check": "yarn a:r health-check.yml health-check",
    "f": "yarn format",
    "fc": "yarn format-check",
    "l": "yarn lint",
    "tc": "yarn type-check",
    "b": "yarn build",
    "bo": "yarn build:only",
    "s": "yarn start",
    "so": "yarn start:only",
    "t": "yarn test",
    "c": "yarn coverage",
    "sn": "yarn sonar",
    "sno": "yarn sonar:only",
    "ss": "yarn sonar-server:start",
    "ssd": "yarn sonar-server:start-database",
    "ssp": "yarn sonar-server:start-persistent",
    "scp": "yarn sonar-server:create-persistent",
    "ds": "yarn docker:start",
    "dst": "yarn docker:stop",
    "dstc": "yarn docker:stop-containers",
    "wg": "yarn watch:generic",
    "wfc": "yarn watch:format-check",
    "wfco": "yarn watch:format-check-onlyChanged",
    "wl": "yarn watch:lint",
    "wlo": "yarn watch:lint-onlyChanged",
    "wtc": "yarn watch:type-check",
    "wb": "yarn watch:build",
    "wt": "yarn watch:test",
    "wto": "yarn watch:test-onlyChanged",
    "pc": "yarn pre-commit",
    "cbt": "yarn check-commit-blocked-terms",
    "ne": "yarn node:env",
    "a:r": "yarn act:run-workflow",
    "a:sc": "yarn act:sonarcloud",
    "a:d": "yarn act:deploy",
    "a:hc": "yarn act:health-check",
    "base:prettier": "yarn prettier --ignore-path .gitignore '!coverage'"
  },
  "dependencies": {
    "@azure/functions": "^4.11.2",
    "mysql2": "^3.9.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/cli": "7.29.7",
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.4.1",
    "@sonar/scan": "^5.0.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/jest": "30.0.0",
    "@types/node": "24.x",
    "babel-jest": "30.4.1",
    "babel-plugin-inline-json-import": "0.3.2",
    "babel-plugin-module-resolver": "5.0.3",
    "better-sqlite3": "12.10.0",
    "eslint": "^10",
    "globals": "^17.6.0",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "jest-mock-extended": "4.0.1",
    "jest-sonar-reporter": "2.0.0",
    "prettier": "3.8.3",
    "ts-jest": "29.4.11",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.60.0"
  },
  "prettier": {
    "arrowParens": "avoid",
    "bracketSameLine": true,
    "bracketSpacing": false,
    "singleQuote": true,
    "trailingComma": "all"
  },
  "jestSonar": {
    "reportPath": "../test-reports",
    "reportFile": "test-report.xml",
    "indent": 2
  }
}
