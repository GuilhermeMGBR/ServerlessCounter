{
  "compilerOptions": {
    "module": "nodenext",
    "target": "es2024",
    "outDir": "../dist",
    "rootDir": ".",
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "sourceMap": true,
    "strict": true,
    "paths": {
      "app": ["./app"],
      "env.types": ["./env.types"],
      "@CounterService/*": ["./CounterService/*"],
      "@shared/*": ["./shared/*"]
    },
    "types": ["jest", "node"],
    "esModuleInterop": true,
    "skipLibCheck": true
  }
}
